  "items": [
    {
      "_id": "2e84c5f9e97b6514",
      "_key": "!actors.items!3fd2443f99331c99.2e84c5f9e97b6514",
      "name": "Пилот",
      "type": "specialization",
      "img": "icons/svg/mystery-man.svg",
      "system": {
        "description": "<p>Вы — мастер манёвров, чья уверенность на виражах заставляет колотиться сердца даже опытных путешественников. Каждая кнопка на пульте — часть вашего тела, а корабль — часть вашего сознания.</p><h3>Рекомендуемые навыки</h3><p>Пилотирование, Механика, Кибершаманство</p><h3>Модификатор репутации</h3><p>0</p><h3>Дополнительный опыт</h3><ul><li>Вы совершили невероятный манёвр, давший преимущество или позволивший избежать серьёзного ущерба — 2 опыта</li><li>Вы одержали победу над противником, будучи за рулём транспортного средства или дрона — 2 опыта</li><li>Вы предложили план, который помог в решении сложной задачи группы с помощью навыка пилотирования — 2 опыта</li></ul><h3>Примеры положительных черт</h3><ul><li>Лучшая позиция</li><li>Чудеса на виражах</li><li>Дроновод</li></ul><h3>Примеры отрицательных черт</h3><ul><li>Неоправданная смелость</li><li>Переживаете за корабль больше, чем за экипаж</li><li>Зависимость от веретенотранса</li></ul><h3>Стартовое снаряжение на выбор</h3><ul><li>Экзоскафандр +1 или Лётная куртка</li><li>Реактивный ранец или Ремонтный набор</li><li>ПОЧИН-К или Разведзонд</li><li>Крюк-кошка + верёвка или Парашют</li></ul>",
        "variations": "Военный пилот, дальнобойщик, оператор дронов",
        "recommendedSkills": [
          "piloting",
          "mechanics",
          "cybershamanism"
        ],
        "reputationModifier": 0,
        "xpActions": "Вы совершили невероятный манёвр, давший преимущество или позволивший избежать серьёзного ущерба — 2 опыта; Вы одержали победу над противником, будучи за рулём транспортного средства или дрона — 2 опыта; Вы предложили план, который помог в решении сложной задачи группы с помощью навыка пилотирования — 2 опыта",
        "traitExamples": "Положительные: Лучшая позиция, Чудеса на виражах, Дроновод. Отрицательные: Неоправданная смелость, Переживаете за корабль больше, чем за экипаж, Зависимость от веретенотранса.",
        "startingGear": "Экзоскафандр +1 или Лётная куртка; Реактивный ранец или Ремонтный набор; ПОЧИН-К или Разведзонд; Крюк-кошка + верёвка или Парашют"
      },
